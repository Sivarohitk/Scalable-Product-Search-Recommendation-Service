APP_SERVICE_NAME=product-search-service
APP_ENVIRONMENT=development
APP_HOST=0.0.0.0
APP_PORT=8000
APP_API_PORT=8000
APP_DB_PORT=5432
APP_REDIS_PORT=6379
APP_LOG_LEVEL=INFO
APP_DATABASE_URL=postgresql+asyncpg://postgres:postgres@localhost:5432/product_search
APP_REDIS_URL=redis://localhost:6379/0
APP_HEALTH_TIMEOUT_SECONDS=1.0
APP_AUTOCOMPLETE_DEFAULT_LIMIT=8
APP_AUTOCOMPLETE_MAX_LIMIT=10
APP_AUTOCOMPLETE_CANDIDATE_LIMIT=40
APP_AUTOCOMPLETE_CACHE_TTL_SECONDS=120
APP_RECOMMENDATIONS_DEFAULT_LIMIT=6
APP_RECOMMENDATIONS_MAX_LIMIT=12
APP_RECOMMENDATIONS_CANDIDATE_LIMIT=24
APP_SEARCH_SEMANTIC_ENABLED=true
APP_SEARCH_LEXICAL_CANDIDATE_LIMIT=250
APP_SEARCH_SEMANTIC_CANDIDATE_LIMIT=150
APP_SEARCH_VECTOR_SIMILARITY_THRESHOLD=0.18
APP_SEARCH_HYBRID_LEXICAL_WEIGHT=0.55
APP_SEARCH_HYBRID_VECTOR_WEIGHT=0.25
APP_SEARCH_HYBRID_POPULARITY_WEIGHT=0.12
APP_SEARCH_HYBRID_RATING_WEIGHT=0.05
APP_SEARCH_HYBRID_AVAILABILITY_WEIGHT=0.03
